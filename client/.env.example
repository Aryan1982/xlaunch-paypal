# -----------------------------------------------------------------------------
# XLaunch web app, PayPal edition (Next.js; deployed on Vercel).
# Locally: cp .env.example .env.local. On Vercel: Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are read at build time: rebuild after changes.
# The PayPal client id comes from the API server (GET /api/billing), so the
# buttons and the server's orders always belong to the same PayPal app.
# -----------------------------------------------------------------------------

# Supabase project (sign-in): the same project as the API server's SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where /api requests are forwarded: the API server (PAYMENT_PROVIDER=paypal), over HTTPS when it's on another host.
API_ORIGIN=http://127.0.0.1:3001

# Shared with the API server's PROXY_SECRET: lets it trust the visitor's address this app forwards.
# PROXY_SECRET=

# Deployed: this app's public origin, and a second domain on the same deployment for the sandboxed video preview.
# NEXT_PUBLIC_APP_ORIGIN=https://xlaunch-paypal.vercel.app
# NEXT_PUBLIC_PREVIEW_ORIGIN=https://xlaunch-paypal-preview.vercel.app

# Canonical links, share cards, sitemap (default https://xlaunch.pro).
# NEXT_PUBLIC_SITE_URL=
