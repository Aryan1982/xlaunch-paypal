# -----------------------------------------------------------------------------
# my-video — server environment
#
# Copy to `server/.env`:
#   cp server/.env.example server/.env
# -----------------------------------------------------------------------------

# OpenAI-compatible chat completions endpoint used for generation.
OPENCODE_API_URL=https://opencode.ai/zen/go/v1/chat/completions

# The writing model: product profile, brief, script, chat planning. Fast and cheap.
OPENCODE_MODEL=qwen3.8-flash

# The models on offer are fixed in src/config.ts (OFFERED_MODELS): Sonnet 5.5,
# the default and always at high effort, and Opus 5.5 (low, medium or high).
# Claude, called directly on Anthropic's API with its own key: films signed in
# with the API, and any claude-* model id (writer, vision) go there.
CLAUDE_API_KEY=

# Motion films: a Claude agent session (Claude Code, via the Agent SDK) makes
# each film in its own Remotion workspace (server/motion-studio; set it up once
# with `npm run motion:setup`). The session runs with shell access on this
# server, so motion stays admin-only unless ENABLE_MOTION=1.
# How a new film's session signs in unless the user picks: "claude-code" (the
# Claude Code login: CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`, or the
# local `claude` login) or "api" (CLAUDE_API_KEY, billed per token).
# MOTION_RUNNER=claude-code
# CLAUDE_CODE_OAUTH_TOKEN=
# Accounts that aren't admins whose films still run on the Claude Code login (comma-separated emails).
# MOTION_SUBSCRIPTION_ACCOUNTS=
# Accounts that pick either model (and Opus's effort), even for a free preview (comma-separated emails).
# MOTION_MODEL_PICKER_ACCOUNTS=
# Model when the project's isn't a Claude model ("opus" = the newest Opus).
# MOTION_MODEL=opus
# Every film's length in seconds.
# MOTION_SECONDS=30
# A free preview: the whole film planned and only its first MOTION_PREVIEW_SECONDS built, in one session,
# with this model (one of the offered ones; anything else means Sonnet) at high effort; buying it resumes
# the session to build the rest.
# MOTION_PREVIEW_SECONDS=10
# MOTION_PREVIEW_MODEL=claude-sonnet-5-5
# Free previews a UTC day across all users (accounts with unlimited previews don't count).
# FREE_PREVIEWS_PER_DAY=5
# MOTION_FPS=60
# MOTION_MAX_TURNS=150

# Bearer token sent as `Authorization: Bearer <key>`.
# Leave empty only if your endpoint does not require authentication.
OPENCODE_API_KEY=

# --- optional tuning ---------------------------------------------------------

# Sampling temperature for code generation.
# Ignored whenever thinking is active (the API forbids combining them).
OPENCODE_TEMPERATURE=0.4

# Cap on completion tokens. Set to 0 to omit the parameter entirely
# (use this if your gateway rejects `max_tokens`).
OPENCODE_MAX_TOKENS=16384

# --- thinking -----------------------------------------------------------------
#
# off (default) | auto | enabled | adaptive | disabled | between_tools
#   off   -> never send a thinking config: the models decide once instead of
#            deliberating in loops (fastest; the pipeline is tuned for it)
#   auto  -> picks what the configured model accepts:
#            Claude 4.7+ / 5.x / Fable / Mythos -> adaptive
#            Claude 4.5 / 4.6 / Haiku 4.5 / other -> enabled
#
# NOTE: Claude 4.7 and later REJECT `thinking.type: "enabled"` with a 400.
#       `adaptive` is rejected on Claude 4.5 / Haiku 4.5.
#       Claude Sonnet 5.5 also rejects `disabled`; use `between_tools` there.
OPENCODE_THINKING_MODE=off

# summarized (default) | omitted
# 5.x models hide thinking unless you ask for "summarized".
OPENCODE_THINKING_DISPLAY=summarized

# Budget for `enabled` thinking (tokens, min 1024, must be < OPENCODE_MAX_TOKENS).
# Ignored in adaptive mode.
OPENCODE_THINKING_BUDGET=2000

# Effort for adaptive thinking: low | medium | high (optional).
# OPENCODE_EFFORT=high

# Header sent with the Anthropic `/messages` shape. Required by
# api.anthropic.com; ignored by Anthropic-compatible gateways.
OPENCODE_ANTHROPIC_VERSION=2023-06-01

# Abort a generation that has not finished within this many milliseconds.
OPENCODE_TIMEOUT_MS=900000

# Abort a call when nothing has streamed in for this long (a stalled model
# fails fast; a slow but steady one is left alone).
# OPENCODE_IDLE_TIMEOUT_MS=30000

# Reads screenshots into design reference (must accept images; unset = OPENCODE_MODEL).
# VISION_MODEL=

# Voice-over with ElevenLabs, for films made with the Narration switch: the film
# agent records each line itself (scripts/voice.mjs, eleven_v3). 0 turns it off,
# e.g. in development: narrated films are then made without a voice-over. The
# free plan works (premade voices, mp3 128 kbps) but is not licensed for
# commercial use.
# ELEVENLABS_KEY=
# ELEVENLABS_ENABLED=1

# HTTP port for the video API. Must match the port the client proxies to.
PORT=3001
# Interface to listen on (the web app proxies /api here)
# HOST=127.0.0.1

# --- using the real Claude API ------------------------------------------------
# OPENCODE_API_URL=https://api.anthropic.com/v1/messages
# OPENCODE_MODEL=claude-sonnet-5-5      # or claude-opus-5-5 / claude-haiku-4-5
# OPENCODE_API_KEY=sk-ant-...


# Public origin of this server: the renderer fetches project assets from it.
# PUBLIC_URL=http://127.0.0.1:3002

# The app's address as users reach it, for links handed out of the app (signed
# export downloads). Defaults to PUBLIC_URL, which is only right locally.
# APP_ORIGIN=https://app.xlaunch.pro

# --- payments (Dodo) -----------------------------------------------------------
# Billing switches on when DODO_PAYMENTS_API_KEY is set (and there is a
# database); credits then replace the monthly video/token quotas. All four
# values belong to ONE Dodo mode: test_mode keys + test products, or live.
# DODO_ENVIRONMENT=test_mode
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
# Printed by: npx tsx scripts/billing/setup-products.ts
# DODO_PRODUCTS='{"pack_pro":"pdt_..."}'
# Charge admins too (to test billing as yourself). Off: admins use the app free.
# BILLING_CHARGE_ADMINS=1

# --- payments (PayPal, the hackathon server) -----------------------------------
# PAYMENT_PROVIDER=paypal sells credit packs through PayPal Checkout (Orders v2)
# instead of Dodo; billing is on with both keys set (and a database). Sandbox
# by default; a sandbox server refuses to start against the production database.
# PAYMENT_PROVIDER=paypal
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# The webhook (POST <API>/api/billing/paypal/webhook) for CHECKOUT.ORDER.APPROVED,
# PAYMENT.CAPTURE.COMPLETED and PAYMENT.CAPTURE.REFUNDED; its id verifies deliveries.
# PAYPAL_WEBHOOK_ID=
# A web app on another host (Vercel) forwards the visitor's address beside this
# shared secret; the same value goes in that app's PROXY_SECRET.
# PROXY_SECRET=

# Export rendering: GL backend for headless Chrome ("angle" = GPU; empty =
# software) and how many tabs render frames in parallel (default: automatic).
# RENDER_GL=angle
# RENDER_CONCURRENCY=

# Prices for the usage ledger (USD per million tokens), JSON; in production the
# model_prices table overrides these. Models without a price still count tokens.
# MODEL_PRICES={"qwen3.8-flash":{"input":0.1,"output":0.4}}

# Stable session id sent to OpenCode Go for routing and prompt caching (default: one per boot).
# OPENCODE_SESSION_ID=

# --- accounts & storage (optional: without them, local mode with no sign-in) --
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Free-tier guards (defaults: 9 GB, 900k class A, 9M class B per month)
# R2_MAX_BYTES=
# R2_MAX_CLASS_A=
# R2_MAX_CLASS_B=
# Signs asset URLs for the renderer and preview (a long random string; dev keeps one in data/)
# ASSET_SIGNING_SECRET=
# Jobs and exports running at once across all projects
# MAX_JOBS=2
# MAX_RENDERS=1

# --- Sign-in emails (server/scripts/auth/email-templates.ts; the running server does not read these)
# Resend API key, send-only: Supabase Auth sends sign-in emails through it (also stored in Supabase SMTP settings)
RESEND_API_KEY=
# The sender of the one follow-up email about an unpaid free preview (src/email/followup.ts).
# Its domain must be verified in Resend; without RESEND_API_KEY and EMAIL_FROM, no email is sent.
EMAIL_FROM=hello@xlaunch.pro
# Supabase personal access token (supabase.com/dashboard/account/tokens), to change auth settings and email templates
SUPABASE_ACCESS_TOKEN=
